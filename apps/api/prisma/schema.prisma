// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           Role           @default(USER)
  isVerified     Boolean        @default(false)

  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  refreshTokens         RefreshToken[]
  procurementRequests   ProcurementRequest[]
  approvalSteps         ApprovalStep[]
  createdRfqs           RFQ[]
  submittedBids         Bid[]
  bidEvaluations        BidEvaluation[]
  awards                Award[]              @relation("AwardedBy")
  issuedPurchaseOrders  PurchaseOrder[]      @relation("IssuedBy")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organisationId, email])
}

enum Role {
  USER
  DEPARTMENT_HEAD
  PROCUREMENT_MANAGER
  FINANCE
  ADMIN
}

model Organisation {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users               User[]
  invitations         Invitation[]
  vendors             Vendor[]
  procurementRequests ProcurementRequest[]
  evaluationCriteria  EvaluationCriteria[]
  purchaseOrders      PurchaseOrder[]
}

enum ProcurementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  CANCELLED
  REJECTED
  APPROVED
}

model ProcurementRequest {
  id                   String              @id @default(cuid())
  organisationId       String
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requesterId          String
  requester            User                @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  title                String
  description          String
  justification        String
  department           String
  estimatedBudget      Decimal             @db.Decimal(14, 2)
  currency             String              @default("USD")
  priority             ProcurementPriority @default(MEDIUM)
  status               ProcurementStatus   @default(DRAFT)
  requiredDeliveryDate DateTime
  items                ProcurementItem[]
  approvalWorkflow     ApprovalWorkflow?
  rfqs                 RFQ[]
  awards               Award[]
  purchaseOrders       PurchaseOrder[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([organisationId])
  @@index([requesterId])
  @@index([status])
  @@index([priority])
  @@index([department])
}

model ProcurementItem {
  id                   String             @id @default(cuid())
  procurementRequestId String
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  description          String
  quantity             Int
  unitPrice            Decimal            @db.Decimal(14, 2)
  totalPrice           Decimal            @db.Decimal(14, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([procurementRequestId])
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum VendorInvitationStatus {
  INVITED
  VIEWED
  RESPONDED
  DECLINED
}

model RFQ {
  id                   String             @id @default(cuid())
  procurementRequestId String
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  rfqNumber            String             @unique
  title                String
  description          String
  closingDate          DateTime
  status               RFQStatus          @default(DRAFT)
  createdById          String
  createdBy            User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  vendors              RFQVendor[]
  bids                 Bid[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([procurementRequestId])
  @@index([status])
  @@index([createdById])
}

model RFQVendor {
  id          String                 @id @default(cuid())
  rfqId       String
  rfq         RFQ                    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedAt   DateTime               @default(now())
  respondedAt DateTime?
  status      VendorInvitationStatus @default(INVITED)

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum WorkflowStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum ApprovalLevelRole {
  DEPARTMENT_HEAD
  PROCUREMENT_MANAGER
  FINANCE
  ADMIN
}

model ApprovalWorkflow {
  id                   String             @id @default(cuid())
  procurementRequestId String             @unique
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  currentLevel         Int                @default(1)
  status               WorkflowStatus     @default(IN_PROGRESS)
  steps                ApprovalStep[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

model ApprovalStep {
  id         String            @id @default(cuid())
  workflowId String
  workflow   ApprovalWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverId String
  approver   User              @relation(fields: [approverId], references: [id], onDelete: Cascade)
  role       ApprovalLevelRole
  level      Int
  status     ApprovalStatus    @default(PENDING)
  comments   String?
  actedAt    DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([workflowId, level])
  @@index([workflowId])
  @@index([approverId])
  @@index([status])
}

enum BidStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  DISQUALIFIED
  AWARDED
}

model Bid {
  id             String         @id @default(cuid())
  rfqId          String
  rfq            RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  submittedById  String
  submittedBy    User           @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  bidNumber      String         @unique
  totalAmount    Decimal        @db.Decimal(14, 2) @default(0)
  currency       String         @default("USD")
  deliveryPeriod String?
  paymentTerms   String?
  warrantyPeriod String?
  notes          String?
  status         BidStatus      @default(DRAFT)
  submittedAt    DateTime?
  items          BidItem[]
  attachments    BidAttachment[]
  evaluations    BidEvaluation[]
  award          Award?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([rfqId])
  @@index([vendorId])
  @@index([submittedById])
  @@index([status])
}

model BidItem {
  id          String   @id @default(cuid())
  bidId       String
  bid         Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 2)
  totalPrice  Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bidId])
}

model BidAttachment {
  id         String   @id @default(cuid())
  bidId      String
  bid        Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())

  @@index([bidId])
}

model EvaluationCriteria {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  weight         Float        @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

model BidEvaluation {
  id               String   @id @default(cuid())
  bidId            String
  bid              Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  evaluatorId      String
  evaluator        User     @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  technicalScore   Float
  commercialScore  Float
  complianceScore  Float
  deliveryScore    Float
  totalScore       Float
  comments         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([bidId, evaluatorId])
  @@index([bidId])
  @@index([evaluatorId])
}

model Award {
  id                   String             @id @default(cuid())
  bidId                String             @unique
  bid                  Bid                @relation(fields: [bidId], references: [id], onDelete: Cascade)
  procurementRequestId String             @unique
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  awardedById          String
  awardedBy            User               @relation("AwardedBy", fields: [awardedById], references: [id], onDelete: Cascade)
  awardReason          String
  awardedAt            DateTime           @default(now())
  purchaseOrder        PurchaseOrder?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([procurementRequestId])
  @@index([awardedById])
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id                   String                @id @default(cuid())
  poNumber             String                @unique
  organisationId       String
  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  vendorId             String
  vendor               Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  awardId              String                @unique
  award                Award                 @relation(fields: [awardId], references: [id], onDelete: Cascade)
  procurementRequestId String
  procurementRequest   ProcurementRequest    @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  issuedById           String
  issuedBy             User                  @relation("IssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)
  issueDate            DateTime?
  expectedDeliveryDate DateTime
  totalAmount          Decimal               @db.Decimal(14, 2) @default(0)
  currency             String                @default("USD")
  paymentTerms         String?
  deliveryAddress      String?
  notes                String?
  status               PurchaseOrderStatus   @default(DRAFT)
  items                PurchaseOrderItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organisationId])
  @@index([vendorId])
  @@index([procurementRequestId])
  @@index([issuedById])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(14, 2)
  totalPrice      Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  token          String           @unique
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role             @default(USER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organisationId])
  @@index([email])
  @@index([status])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

enum ComplianceStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Vendor {
  id                      String           @id @default(cuid())
  organisationId          String
  organisation            Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                    String
  email                   String
  phone                   String?
  address                 String?
  website                 String?
  registrationNumber      String?
  taxIdentificationNumber String?
  category                String?
  status                  VendorStatus     @default(ACTIVE)
  rating                  Float?
  complianceStatus        ComplianceStatus @default(PENDING)
  notes                   String?
  rfqVendors              RFQVendor[]
  bids                    Bid[]
  purchaseOrders          PurchaseOrder[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([organisationId, email])
  @@unique([organisationId, registrationNumber])
  @@index([organisationId])
  @@index([status])
  @@index([complianceStatus])
  @@index([category])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}
