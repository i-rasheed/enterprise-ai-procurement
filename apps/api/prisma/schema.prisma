// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           Role           @default(USER)
  isVerified     Boolean        @default(false)

  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  refreshTokens         RefreshToken[]
  procurementRequests   ProcurementRequest[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organisationId, email])
}

enum Role {
  USER
  ADMIN
  PROCUREMENT_MANAGER
}

model Organisation {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users               User[]
  invitations         Invitation[]
  vendors             Vendor[]
  procurementRequests ProcurementRequest[]
}

enum ProcurementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  CANCELLED
  REJECTED
  APPROVED
}

model ProcurementRequest {
  id                   String              @id @default(cuid())
  organisationId       String
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requesterId          String
  requester            User                @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  title                String
  description          String
  justification        String
  department           String
  estimatedBudget      Decimal             @db.Decimal(14, 2)
  currency             String              @default("USD")
  priority             ProcurementPriority @default(MEDIUM)
  status               ProcurementStatus   @default(DRAFT)
  requiredDeliveryDate DateTime
  items                ProcurementItem[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([organisationId])
  @@index([requesterId])
  @@index([status])
  @@index([priority])
  @@index([department])
}

model ProcurementItem {
  id                   String             @id @default(cuid())
  procurementRequestId String
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  description          String
  quantity             Int
  unitPrice            Decimal            @db.Decimal(14, 2)
  totalPrice           Decimal            @db.Decimal(14, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([procurementRequestId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  token          String           @unique
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role             @default(USER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organisationId])
  @@index([email])
  @@index([status])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

enum ComplianceStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Vendor {
  id                      String           @id @default(cuid())
  organisationId          String
  organisation            Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                    String
  email                   String
  phone                   String?
  address                 String?
  website                 String?
  registrationNumber      String?
  taxIdentificationNumber String?
  category                String?
  status                  VendorStatus     @default(ACTIVE)
  rating                  Float?
  complianceStatus        ComplianceStatus @default(PENDING)
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([organisationId, email])
  @@unique([organisationId, registrationNumber])
  @@index([organisationId])
  @@index([status])
  @@index([complianceStatus])
  @@index([category])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}
