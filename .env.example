NODE_ENV=development

# Web app: http://localhost:3000
# API:      http://localhost:3001  (Swagger at /docs)
# Docs app: http://localhost:3002

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procurement

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

# Security
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
ENABLE_RESPONSE_WRAPPER=true
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# AI
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.3
MAX_TOKENS=4096
AI_TIMEOUT_MS=60000

# Storage (local | s3 | minio | r2 | azure)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (optional). Gmail: use port 465 if 587 times out (common on some ISPs).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
FRONTEND_URL=http://localhost:3000

# Registration — block personal email domains on self-serve org signup
REGISTRATION_ALLOW_PERSONAL_EMAIL=false

# Observability
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-procurement-api

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PROFESSIONAL=
PAYSTACK_PLAN_ENTERPRISE=

PORT=3001
